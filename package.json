{
  "name": "@fortmesa/verdaccio-attestations",
  "version": "1.1.3",
  "description": "Verdaccio plugin: accepts and stores npm provenance/Sigstore attestations on publish (working around Verdaccio's own single-attachment publish limit), serves them back via the real npm attestations endpoint (proxying and caching from upstream for non-local packages), and optionally enforces that matching packages have a cryptographically verified attestation before they can be installed",
  "license": "MIT",
  "repository": "fortmesa/verdaccio-attestations",
  "homepage": "https://github.com/fortmesa/verdaccio-attestations#readme",
  "keywords": [
    "verdaccio",
    "verdaccio-plugin",
    "npm-registry",
    "supply-chain-security",
    "provenance",
    "attestations",
    "sigstore"
  ],
  "main": "index.js",
  "packageManager": "yarn@4.17.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "verify.js",
    "keys.js"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "node test/smoke.js",
    "test:cli": "node test/cli-real.js"
  },
  "lint-staged": {
    "**/*.{js,yml,yaml,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "body-parser": "^1.20.5",
    "https-proxy-agent": "^9.1.0",
    "minimatch": "^10.2.5",
    "node-fetch": "^2.7.0",
    "npm-package-arg": "^14.0.0",
    "semver": "^7.8.5",
    "sigstore": "^5.0.0",
    "ssri": "^14.0.0"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.3",
    "verdaccio": "^6.0.0"
  }
}
